# 이 파일을 .env 로 복사해 값을 채우세요. ORACLE_* 를 비워 두면 데모 모드(DuckDB)로 실행됩니다.

# --- Oracle 접속 (SELECT 권한만 가진 읽기 전용 계정 권장)
ORACLE_USER=
ORACLE_PASSWORD=
# 예: dbhost.example.com:1521/ORCLPDB1
ORACLE_DSN=
ORACLE_POOL_MAX=8

# --- 탐색 대상 Owner (쉼표 구분). INCLUDE_OWNERS 를 지정하면 그 Owner 만 보인다.
INCLUDE_OWNERS=
EXCLUDE_OWNERS=

# --- 실행 제한
QUERY_TIMEOUT_SEC=30
EXPORT_TIMEOUT_SEC=300
EXACT_PROFILE_TIMEOUT_SEC=120
SQL_MAX_ROWS=10000
EXPORT_MAX_ROWS=1000000
PAGE_MAX_ROWS=500
SQL_CONCURRENCY=4
SAMPLE_TARGET_ROWS=100000
METADATA_CACHE_SEC=300
ALLOW_DB_LINKS=false
